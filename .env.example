# Образец настроек. Скопируй в .env и раскомментируй, что нужно поменять:
#     cp .env.example .env
# Без .env всё работает на значениях по умолчанию (они указаны ниже).
# Комментарии — только на отдельных строках, не после значения.

# ---------- сервер CARLA ----------
# где запущен сервер
# CARLA_HOST=localhost
# CARLA_PORT=2000
# сцена загрузит эту карту, если открыта другая (пусто — не трогать)
# CARLA_MAP=Town05
# порт Traffic Manager
# TM_PORT=8000

# ---------- сцена: машины и светофор ----------
# тот же SEED — тот же поток машин
# SEED=42
# машин в час на всех подъездах
# VEH_PER_HOUR=1200
# потолок машин одновременно
# MAX_VEHICLES=60
# длительности фаз, с: едет главная / едет наша дорога / идут пешеходы (PED не меньше ~18)
# PHASE_MAIN=20
# PHASE_SIDE=15
# PHASE_PED=20

# ---------- пешеходы ----------
# появлений в час на обе стороны
# PED_PER_HOUR=360
# живых пешеходов с одной стороны (много — толкаются и вылетают на дорогу)
# MAX_PER_SIDE=3
# скорость, м/с
# PED_SPEED_MIN=1.2
# PED_SPEED_MAX=1.6
# запас, с: переходит, только если успевает до конца PED
# CROSS_MARGIN=2
# debug-отрисовка зон; 0 — при записи кадров для YOLO
# DRAW_DEBUG=1

# ---------- отправка по WebSocket ----------
# WS_HOST=0.0.0.0
# WS_PORT=8765
# с симуляции между сообщениями
# SEND_PERIOD=0.5
# м, докуда по нашей дороге считаем машины
# ROAD_LENGTH=50

# ---------- ползунки debug_view.py -> сцена (UDP) ----------
# 127.0.0.1 — управлять можно только с этой машины; 0.0.0.0 — из сети
# CONTROL_HOST=127.0.0.1
# CONTROL_PORT=8770
